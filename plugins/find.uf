const { Module } = require('../main');
const config = require('../config');
const axios = require('axios');
const FormData = require('form-data');

function getFindEndpoint() {
    const configured = config.FIND_API_URL || process.env.FIND_API_URL || config.PAIRING_URL || process.env.PAIRING_URL || process.env.APP_URL;
    if (!configured) return null;
    const value = String(configured).replace(/\/+$/, '');
    return value.endsWith('/api/find') ? value : `${value}/api/find`;
}

function getFindApiToken() {
    return config.FIND_API_TOKEN || process.env.FIND_API_TOKEN || '';
}

function clean(value) {
    return String(value || '').replace(/[\u0000-\u001f\u007f]/g, ' ').replace(/\s+/g, ' ').trim();
}

function formatResult(data) {
    const result = data?.result || {};
    const lines = [
        '*Music Found*',
        '',
        `*Title:* ${clean(result.title) || 'Unknown'}`,
        `*Artist:* ${clean(result.artist) || 'Unknown'}`
    ];
    if (result.album) lines.push(`*Album:* ${clean(result.album)}`);
    if (result.release_date) lines.push(`*Release date:* ${clean(result.release_date)}`);
    if (result.timecode) lines.push(`*Matched at:* ${clean(result.timecode)}`);
    if (result.song_link) lines.push(`*Song link:* ${result.song_link}`);
    if (result.apple_music?.url) lines.push(`*Apple Music:* ${result.apple_music.url}`);
    if (result.spotify?.external_urls?.spotify) lines.push(`*Spotify:* ${result.spotify.external_urls.spotify}`);
    lines.push('', '_Identified by audio fingerprint. A clearer 10–20 second section gives the best result._');
    return lines.join('\n');
}

Module({
    pattern: 'find ?(.*)',
    desc: 'Identify music from a replied audio or video.',
    use: 'media',
    usage: 'find (reply to audio/video)',
    warn: 'Reply to an audio, voice note, or video with this command.'
}, async (message) => {
    const reply = message.reply_message;
    const hasMedia = reply && (
        reply.audio || reply.voice || reply.video || reply.video_note || reply.document
    );
    if (!hasMedia) {
        return message.sendReply('_Reply to an audio, voice note, or video with `find`._');
    }

    const endpoint = getFindEndpoint();
    if (!endpoint) {
        return message.sendReply('_The music finder endpoint is not configured. Set `FIND_API_URL` or `PAIRING_URL`._');
    }

    let status;
    try {
        status = await message.sendReply('_Finding the music..._');
        const audioBuffer = await reply.download('buffer');
        if (!audioBuffer || !audioBuffer.length) throw new Error('The replied media is empty.');

        const form = new FormData();
        form.append('file', audioBuffer, {
            filename: 'telegram-media.bin',
            contentType: reply.mimetype || 'application/octet-stream'
        });

        const apiToken = getFindApiToken();
        const response = await axios.post(endpoint, form, {
            headers: {
                ...form.getHeaders(),
                ...(apiToken ? { Authorization: `Bearer ${apiToken}` } : {})
            },
            timeout: 180000,
            maxContentLength: Infinity,
            maxBodyLength: Infinity,
            validateStatus: () => true
        });

        if (response.status >= 400 || !response.data?.success) {
            throw new Error(response.data?.error || `Finder endpoint returned HTTP ${response.status}.`);
        }

        await message.edit(formatResult(response.data), message.jid, status.key);
    } catch (error) {
        const text = clean(error?.response?.data?.error || error?.message) || 'Music identification failed.';
        if (status) await message.edit(`_Error:_ ${text}`, message.jid, status.key).catch(() => {});
        else await message.sendReply(`_Error:_ ${text}`).catch(() => {});
    }
});
